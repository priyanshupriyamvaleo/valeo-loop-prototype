# Copy this file to .env.local and paste your own values in.
# .env.local is gitignored. .env.example is not, and must stay empty of secrets.
#
# Supabase dashboard -> Project Settings -> API
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "anon" "public" key  (NOT the service_role key)
#
# The anon key is written into the public bundle at build time. That is the
# normal Supabase design: the row level security rules on the comments table
# are what grant access, not the secrecy of this key.
# The service_role key bypasses those rules. It must never appear here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
