# Copy to .env.local and fill in.

# ── Content service ───────────────────────────────────────────
# Server-only (no NEXT_PUBLIC_ prefix): the browser talks to /api/cms/* and the
# Next route handler attaches the token.
CONTENT_API_BASE=https://contentservice-dev.feelvaleo.com/api/v1/admin

# Origin of the auth endpoints. They live at /api/v1/validate/..., a different
# prefix from CONTENT_API_BASE, so it is derived from that URL's origin unless
# set here. Only needed when auth is served from somewhere else.
CONTENT_API_ORIGIN=http://localhost:8080

# ── Google sign-in ────────────────────────────────────────────
# The OAuth 2.0 WEB client id. NEXT_PUBLIC_ on purpose: Google Identity Services
# runs in the browser and a client id is public by design — the client SECRET is
# not used here and must never be added.
#
# The deployment's own origin must be listed under that client's "Authorized
# JavaScript origins" in Google Cloud Console, or the button renders and no
# credential is ever issued. It must also match catalog.admin.google.client-id
# on the content service, which rejects any token with a different audience.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=15879832770-5q7mn1ssc56vljm7jcq186nmod0l9i34.apps.googleusercontent.com

# The client SECRET for that same client. Server-only — NEVER prefix this with
# NEXT_PUBLIC_, which would compile it into the browser bundle and publish it.
# It is used once per sign-in, to redeem the authorization code with Google.
# No fallback value: unset means sign-in fails loudly rather than half-working.
GOOGLE_CLIENT_SECRET=

# ── Shared-token escape hatch (default: off) ──────────────────
# Before sign-in existed, /api/cms/* attached one shared token to every request,
# which means anyone who could load the page could read and write the catalogue.
# It is now used ONLY if the flag below is exactly "true". Turn it on for a demo
# where nobody can sign in yet, and remember that every write in that window is
# audited as a single anonymous identity rather than a person.
CONTENT_API_TOKEN=
CONTENT_API_ALLOW_SHARED_TOKEN=

# Media upload route on the content service, relative to CONTENT_API_BASE
# (e.g. "media/upload"). Leave blank until the endpoint exists — the editor
# then previews files locally and says they are not stored.
NEXT_PUBLIC_MEDIA_UPLOAD_PATH=

# ── Local development: skip sign-in ───────────────────────────
# Google sign-in cannot complete on localhost unless this origin is listed under
# the OAuth client's "Authorized JavaScript origins". Rather than hand-setting
# session cookies in the devtools console, set this:
AUTH_DEV_BYPASS=1
#
# It is guarded by TWO independent locks and needs both:
#   1. NODE_ENV !== "production"  — structural. A production build cannot take
#      this path whatever the flag says, so copying the flag into a production
#      environment by accident is harmless.
#   2. AUTH_DEV_BYPASS=1          — explicit opt-in, so a plain `npm run dev`
#      is still gated by default.
#
# The bypassed session carries NO content-service token, because the session IS
# that token. Biomarkers, Panels and Create Your Own Test work (Postgres and
# LOINC need no token); listings and the master sheet will 401. For those, use
# the proxy's existing shared-token hatch — CONTENT_API_TOKEN plus
# CONTENT_API_ALLOW_SHARED_TOKEN=true — and note every write then attributes to
# that token's user.
